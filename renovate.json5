// Renovate keeps the dependencies of this repository current in batches, the
// way operator-component-framework does: minor and patch updates arrive on
// the 1st and the 15th, grouped so that one pull request carries what has to
// land together, and a major update arrives when it is published. Go modules,
// .tool-versions, GitHub Actions, the Dockerfiles, and requirements-docs.txt
// go through the standard managers.
//
// The image pins of the e2e suite are the env files under test/e2e/matrix/
// (one per supported Camunda minor), three Go constants, a YAML image field,
// and two Makefile variables, which no standard manager reads, so a marker
// comment above each one names what to track:
//
//   # renovate: datasource=docker depName=camunda/camunda
//   CAMUNDA_VERSION=8.9.17
//
// The example inventories under config/example/ run the versions the matrix
// entry tests, so each version field of a manifest carries the same marker.
// One pull request moves both, because every marked pin belongs to the group
// e2e-image-pins below. `make lint` fails when an inventory and the matrix
// entry differ.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  // config:recommended skips every **/test/** path, and that is where the
  // e2e pins live.
  ignorePaths: [],
  // An alpha or snapshot tag of the next Camunda minor never lands.
  ignoreUnstable: true,
  customManagers: [
    {
      // A variable of an env file or of the Makefile: the marker, then
      // `NAME=<version>` or `NAME ?= <version>` on the next line.
      customType: "regex",
      managerFilePatterns: ["/^test/e2e/matrix/.*\\.env$/", "/^Makefile$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\w+\\s*\\??=\\s*(?<currentValue>\\S+)",
      ],
    },
    {
      // A Go constant: the marker, then `name = "<version>"` or
      // `name = "<image>:<version>"` on the next line, inside a const block
      // or after a const keyword of its own.
      customType: "regex",
      managerFilePatterns: ["/\\.go$/"],
      matchStrings: [
        "// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*(?:const\\s+)?\\w+\\s*=\\s*\"(?:[^\"]*:)?(?<currentValue>[^\"]+)\"",
      ],
    },
    {
      // A YAML image field: the marker, then `image: <image>:<version>`.
      customType: "regex",
      managerFilePatterns: ["/^test/e2e/testdata/.*\\.yaml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*image:\\s*\\S+:(?<currentValue>\\S+)",
      ],
    },
    {
      // A version field of an example inventory: the marker, then
      // `version: "<version>"` on the next line. The inventories name a
      // version, not an image, because each kind of this operator builds the
      // pull reference from it.
      customType: "regex",
      managerFilePatterns: ["/^config/example/.*\\.yaml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*version:\\s*\"(?<currentValue>[^\"]+)\"",
      ],
    },
  ],
  packageRules: [
    {
      // Minor and patch updates arrive twice a month. A major update arrives
      // when it is published.
      matchUpdateTypes: ["minor", "patch"],
      schedule: ["* * 1,15 * *"],
    },
    {
      matchFileNames: [".tool-versions"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "tool-versions",
    },
    {
      matchPackageNames: [
        "github.com/onsi/ginkgo/v2",
        "github.com/onsi/gomega",
        "github.com/stretchr/testify",
      ],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "test-dependencies",
    },
    {
      description: "controller-runtime is built against a specific k8s.io minor. Upgrading either alone produces a combination that is not in the compatibility matrix, so they must land together.",
      matchPackageNames: [
        "sigs.k8s.io/controller-runtime",
        "k8s.io/api",
        "k8s.io/apiextensions-apiserver",
        "k8s.io/apimachinery",
        "k8s.io/client-go",
      ],
      groupName: "kubernetes-and-controller-runtime",
    },
    {
      // Every e2e image pin stays on its minor. A new Camunda minor is a
      // supported-version decision the operator makes on purpose.
      matchManagers: ["custom.regex"],
      matchUpdateTypes: ["major", "minor"],
      enabled: false,
    },
    {
      // One pull request carries every e2e image patch of the schedule: each
      // pull request costs a full e2e run, and the pins are independent of
      // each other. The example inventories join the group, so the manifests
      // a user applies move with the matrix that tests them.
      // separateMinorPatch keeps the patch alive when a newer minor exists;
      // without it the minor and the patch share one update, and the rule
      // above drops it whole.
      matchManagers: ["custom.regex"],
      separateMinorPatch: true,
      groupName: "e2e-image-pins",
    },
    {
      // curl and Keycloak are test fixtures with no minor to hold. Camunda 8.9
      // supports every Keycloak 26.x, and the major stays off above. The
      // Keycloak of the management plane flow has a bound of its own below.
      matchDepNames: ["curlimages/curl", "quay.io/keycloak/keycloak", "camunda/keycloak"],
      matchUpdateTypes: ["minor"],
      enabled: true,
    },
    {
      // The Keycloak that the management plane flow runs through the
      // Keycloak Operator. From 26.7.0 Keycloak refuses every update of the
      // realm-management client (the fix of CVE-2026-9796,
      // keycloak/keycloak#49624), and Management Identity 8.9 updates that
      // client when it sets up the realm, so it never starts. The bound
      // lifts when an Identity 8.9 patch starts against 26.7. The example
      // inventories run the same Keycloak, so the bound covers them too.
      matchFileNames: ["test/e2e/matrix/8.9.env", "config/example/**"],
      matchDepNames: ["camunda/keycloak"],
      versioning: "semver",
      allowedVersions: "<26.7.0",
    },
    {
      // The ECK operator the suite installs has to stay on the minor of the
      // cloud-on-k8s module the operator renders with, so the module, the
      // Makefile pin, and the Go pin move in one pull request. This is the
      // one place a pin of the suite takes a minor. One update per pin, so
      // the pull request carries one ECK release, not a patch and a minor.
      matchPackageNames: ["github.com/elastic/cloud-on-k8s/v3", "elastic/cloud-on-k8s"],
      separateMinorPatch: false,
      groupName: "eck",
    },
    {
      matchPackageNames: ["github.com/elastic/cloud-on-k8s/v3", "elastic/cloud-on-k8s"],
      matchUpdateTypes: ["minor", "patch"],
      enabled: true,
    },
    {
      // The Renovate release behind `make lint-renovate` is a tool, not an
      // image: it moves with the tools, and it takes a major, because a new
      // major is when the schema it checks against can change.
      matchDepNames: ["renovate"],
      groupName: "tool-versions",
    },
    {
      matchDepNames: ["renovate"],
      matchUpdateTypes: ["major", "minor"],
      enabled: true,
    },
    {
      // CloudNativePG stays on the minor that internal/testenv/crds/cnpg
      // vendors the CRDs from: a new minor changes the schema the envtest
      // suites check against, and 1.31 removes the in-tree Barman Cloud
      // support that the plugin replaces. Adopting one re-vendors the CRDs.
      matchFileNames: ["test/e2e/matrix/8.9.env"],
      matchDepNames: ["cloudnative-pg/cloudnative-pg"],
      versioning: "semver",
      allowedVersions: "<1.31.0",
    },
    {
      // The Barman Cloud plugin stays on the minor that
      // internal/testenv/crds/barmancloud vendors the ObjectStore CRD from,
      // for the same reason. It is below 1.0, so a minor of it can change
      // the schema.
      matchFileNames: ["test/e2e/matrix/8.9.env"],
      matchDepNames: ["cloudnative-pg/plugin-barman-cloud"],
      versioning: "semver",
      allowedVersions: "<0.15.0",
    },
    {
      // The Camunda images of the 8.9 line. Semver reads 8.10.0-alpha1 and
      // 8.9.9992-SNAPSHOT as prereleases, which ignoreUnstable drops. The
      // Docker versioning would not. A new supported minor gets a file
      // test/e2e/matrix/<minor>.env, a pair of matrix entries in
      // .github/workflows/test-e2e.yml, and a rule like this one with its own
      // bound. The example inventories show one minor at a time. They move to
      // the rule of the new minor when they adopt it.
      matchFileNames: ["test/e2e/matrix/8.9.env", "config/example/**"],
      matchDepNames: [
        "camunda/camunda",
        "camunda/connectors-bundle",
        "camunda/optimize",
        "camunda/identity",
        "camunda/console",
        "camunda/web-modeler-restapi",
      ],
      versioning: "semver",
      allowedVersions: "<8.10.0",
    },
  ],
}
