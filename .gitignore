# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/*
Dockerfile.cross
Dockerfile.cli.cross

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Go workspace file
go.work

# Kubernetes Generated files - skip generated files, except for vendored files
!vendor/**/zz_generated.*

# editor and IDE paraphernalia
.idea
.vscode
*.swp
*.swo
*~

# Kubeconfig might contain secrets
*.kubeconfig

# helm dist — everything under dist/ is generated except the hand-maintained
# chart metadata below, which `make helm-generate` preserves rather than
# overwrites. Keep this allowlist in step with the files that survive it.
dist/**/*
!dist/chart/
!dist/chart/Chart.yaml
!dist/chart/README.md
# mkdocs build output
site/

# The kubebuilder helm/v2-alpha plugin regenerates this scaffold workflow on
# every `make helm-generate`, silently reverting any edits. Our real chart CI
# lives in .github/workflows/chart.yml, at a path the plugin does not own.
.github/workflows/test-chart.yml
