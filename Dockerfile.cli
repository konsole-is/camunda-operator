# Build the camunda-operator-cli binary
FROM golang:1.27 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
# Copy the Go Modules manifests
COPY go.mod go.mod
COPY go.sum go.sum
# The api module is replaced with ./api, so its module files must be present too
COPY api/go.mod api/go.mod
COPY api/go.sum api/go.sum
# cache deps before building and copying source so that we don't need to re-download as much
# and so that source changes don't invalidate our downloaded layer.
# The module proxy sometimes resets a stream in the middle of a download. That
# fails the whole image build, and with it the e2e run that builds it, so give
# the download a few attempts before it gives up.
RUN for attempt in 1 2 3; do \
        go mod download && break; \
        if [ "$attempt" = 3 ]; then echo "go mod download failed after 3 attempts" >&2; exit 1; fi; \
        echo "go mod download failed, retrying in 5s" >&2; \
        sleep 5; \
    done

# Copy the Go source (relies on .dockerignore to filter)
COPY . .

# Build. See Dockerfile for why GOARCH has no default.
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o camunda-operator-cli ./cmd/camunda-operator-cli

# Use distroless as minimal base image to package the CLI binary. The operator's
# Jobs run this image as a container; the manager never does.
FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/camunda-operator-cli .
USER 65532:65532

ENTRYPOINT ["/camunda-operator-cli"]
