# The image versions the e2e suite runs against for Camunda 8.9: the newest
# patch of each line. `make test-e2e E2E_CAMUNDA_MINOR=8.9` exports this file
# to the suite, and the e2e workflow runs one job per file in this directory.
# Renovate reads the marker above each line and opens a pull request when a
# newer patch lands. The bound that keeps it on 8.9 is in renovate.json5.
# renovate: datasource=docker depName=camunda/camunda
CAMUNDA_VERSION=8.9.17
# renovate: datasource=docker depName=camunda/connectors-bundle
CAMUNDA_CONNECTORS_VERSION=8.9.8
# renovate: datasource=docker depName=camunda/optimize
CAMUNDA_OPTIMIZE_VERSION=8.9.17
# renovate: datasource=docker depName=docker.elastic.co/elasticsearch/elasticsearch
ELASTICSEARCH_VERSION=9.2.8
