# One matrix entry of the e2e suite: Camunda 8.9. `make test-e2e
# E2E_CAMUNDA_MINOR=8.9` exports this file to the suite, and the e2e workflow
# runs one job per file in this directory.
#
# The image versions are the newest patch of each line. Renovate reads the
# marker above each one and opens a pull request when a newer patch lands. The
# bound that keeps them on 8.9 is in renovate.json5.
# renovate: datasource=docker depName=camunda/camunda
CAMUNDA_VERSION=8.9.18
# renovate: datasource=docker depName=camunda/connectors-bundle
CAMUNDA_CONNECTORS_VERSION=8.9.9
# renovate: datasource=docker depName=camunda/optimize
CAMUNDA_OPTIMIZE_VERSION=8.9.18
# renovate: datasource=docker depName=docker.elastic.co/elasticsearch/elasticsearch
ELASTICSEARCH_VERSION=9.2.8
# The images of the management plane. Management Identity, Console, and Web
# Modeler carry a patch line of their own inside the 8.9 minor, so none of
# them follows CAMUNDA_VERSION. Camunda 8.9 supports Keycloak 26 only, and the
# operator pulls the Camunda build of it as camunda/keycloak:quay-optimized-<version>.
# The suite installs the Keycloak Operator of the same release, because the
# operator and the Keycloak it runs must match.
#
# Keycloak stays below 26.7. From 26.7.0 Keycloak refuses every update of the
# realm-management client (the fix of CVE-2026-9796, keycloak/keycloak#49624),
# and Management Identity 8.9 updates that client when it sets up the realm,
# so it never starts. The bound is in renovate.json5.
# renovate: datasource=docker depName=camunda/identity
CAMUNDA_IDENTITY_VERSION=8.9.9
# renovate: datasource=docker depName=camunda/console
CAMUNDA_CONSOLE_VERSION=8.9.93
# renovate: datasource=docker depName=camunda/web-modeler-restapi
CAMUNDA_WEB_MODELER_VERSION=8.9.8
# renovate: datasource=docker depName=camunda/keycloak extractVersion=^quay-optimized-(?<version>\d+\.\d+\.\d+)$
KEYCLOAK_VERSION=26.6.4
# CloudNativePG runs the PostgreSQL server of a DatabaseServer, and the Barman
# Cloud plugin writes its continuous archive. Both stay on the minor that
# internal/testenv/crds vendors the CRDs from, so the envtest suites and this
# suite check one schema. The bound is in renovate.json5.
# renovate: datasource=github-releases depName=cloudnative-pg/cloudnative-pg extractVersion=^v(?<version>.*)$
CNPG_VERSION=1.30.0
# renovate: datasource=github-releases depName=cloudnative-pg/plugin-barman-cloud extractVersion=^v(?<version>.*)$
BARMAN_PLUGIN_VERSION=0.14.0
#
# E2E_LABELS names the spec flows that run for this minor: a comma-separated
# list of the labels in test/e2e/matrix_test.go. Empty runs every flow. A "!"
# prefix excludes a flow, so "camundacluster,!camundacluster-oidc" runs the
# CamundaCluster flow without the OIDC one.
E2E_LABELS=
