{
  "schemaVersion": 1,
  "name": "connectors serviceAccount create overrides and the annotations merge by key",
  "rule": "`connectors.serviceAccount`",
  "preset": {
    "cluster": {
      "connectors": {
        "serviceAccount": {
          "create": false,
          "annotations": {
            "team": "preset",
            "shared": "preset"
          }
        }
      }
    }
  },
  "spec": {
    "connectors": {
      "serviceAccount": {
        "create": true,
        "annotations": {
          "shared": "cluster"
        }
      }
    }
  },
  "merged": {
    "connectors": {
      "serviceAccount": {
        "create": true,
        "annotations": {
          "shared": "cluster",
          "team": "preset"
        }
      }
    }
  }
}
