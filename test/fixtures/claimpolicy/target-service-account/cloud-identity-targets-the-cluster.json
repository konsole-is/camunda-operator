{
  "schemaVersion": 1,
  "name": "A section with another slot targets the cluster",
  "input": {
    "kind": "CamundaClusterClaim",
    "claim": "team-a",
    "section": {
      "metadata": {
        "name": "cloud-identity"
      },
      "spec": {
        "label": "cloud-identity",
        "selection": "One",
        "appliesTo": [
          "CamundaClusterClaim"
        ],
        "slot": "workloadIdentity"
      }
    }
  },
  "result": {
    "value": {
      "serviceAccountName": "team-a-camunda"
    }
  }
}
