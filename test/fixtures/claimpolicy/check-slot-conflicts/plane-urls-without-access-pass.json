      },
      {
        "metadata": {
          "name": "encryption-key"
        },
        "spec": {
          "label": "encryption-key",
          "selection": "One",
          "appliesTo": [
            "CamundaClusterClaim"
          ]
        }
      },
      {
        "metadata": {
          "name": "volume-encryption"
        },
        "spec": {
          "label": "volume-encryption",
          "selection": "One",
          "appliesTo": [
            "CamundaClusterClaim"
          ],
          "slot": "volumeEncryption"
        }
      },
      {
        "metadata": {
          "name": "backup-storage"
        },
        "spec": {
          "label": "backup-storage",
          "selection": "One",
          "appliesTo": [
            "CamundaClusterClaim"
          ],
          "slot": "backupStorage"
