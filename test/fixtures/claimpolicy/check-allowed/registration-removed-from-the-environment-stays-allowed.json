{
  "schemaVersion": 1,
  "name": "A registration that the Environment no longer lists stays allowed for a claim whose snapshot allows it",
  "input": {
    "environment": {
      "metadata": {
        "name": "dev"
      },
      "spec": {
        "presets": {
          "camundaCluster": [
            "small"
          ]
        },
        "sections": {
          "backup-storage": {
            "allowed": [
              "existing-object-storage"
            ]
          }
        }
      }
    },
    "policy": {
      "sections": {
        "backup-storage": {
          "allowed": [
            "s3",
            "existing-object-storage"
          ]
        }
      },
      "parameters": {
        "s3": {
          "region": {
            "value": "eu-west-1"
          },
          "access": {
            "claimEditable": true,
            "allowed": [
              {
                "name": "sqs",
                "label": "SQS access",
                "value": "arn:aws:iam::aws:policy/AmazonSQSFullAccess"
              },
              {
                "name": "sns",
                "label": "SNS access",
                "value": "arn:aws:iam::aws:policy/AmazonSNSFullAccess"
              }
            ]
          }
        }
      },
      "deletionPolicy": "Delete"
    },
    "selections": [
      {
        "section": "backup-storage",
        "registration": "s3"
      }
    ]
  },
  "result": {
    "value": {}
  }
}
