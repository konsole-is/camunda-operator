{
  "schemaVersion": 1,
  "name": "A preset that is not a string is left to the parameter schema",
  "input": {
    "environment": {
      "metadata": {
        "name": "dev"
      },
      "spec": {
        "presets": {
          "elasticsearchCluster": [
            "small"
          ]
        }
      }
    },
    "policy": {
      "sections": {
        "secondary-storage": {
          "allowed": [
            "elasticsearch",
            "database-server"
          ]
        }
      },
      "parameters": {
        "elasticsearch": {
          "preset": {
            "claimEditable": true
          }
        }
      }
    },
    "selections": [
      {
        "section": "secondary-storage",
        "registration": "elasticsearch",
        "parameters": {
          "preset": 5
        }
      }
    ]
  },
  "result": {
    "value": {}
  }
}
