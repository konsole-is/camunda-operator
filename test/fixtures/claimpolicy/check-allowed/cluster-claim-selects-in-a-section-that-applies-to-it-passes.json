{
  "schemaVersion": 1,
  "name": "A cluster claim that selects in sections that apply to cluster claims passes",
  "input": {
    "kind": "CamundaClusterClaim",
    "sections": [
      {
        "metadata": {
          "name": "backup-storage"
        },
        "spec": {
          "label": "backup-storage",
          "selection": "One",
          "appliesTo": [
            "CamundaClusterClaim"
          ]
        }
      },
      {
        "metadata": {
          "name": "management-database"
        },
        "spec": {
          "label": "management-database",
          "selection": "One",
          "appliesTo": [
            "CamundaManagementClusterClaim"
          ]
        }
      },
      {
        "metadata": {
          "name": "access"
        },
        "spec": {
          "label": "access",
          "selection": "One",
          "appliesTo": [
            "CamundaClusterClaim",
            "CamundaManagementClusterClaim"
          ]
        }
      }
    ],
    "policy": {
      "sections": {
        "backup-storage": {
          "allowed": [
            "s3"
          ]
        },
        "management-database": {
          "allowed": [
            "management-database-server"
          ]
        },
        "access": {
          "allowed": [
            "ingress"
          ]
        }
      },
      "deletionPolicy": "Delete"
    },
    "selections": [
      {
        "section": "backup-storage",
        "registration": "s3"
      },
      {
        "section": "access",
        "registration": "ingress"
      }
    ]
  },
  "result": {
    "value": {}
  }
}
