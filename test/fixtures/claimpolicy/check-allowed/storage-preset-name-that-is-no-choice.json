{
  "schemaVersion": 1,
  "name": "A preset name that is no choice is refused as a choice before the preset list is checked",
  "input": {
    "environment": {
      "metadata": {
        "name": "dev"
      },
      "spec": {
        "presets": {
          "elasticsearchCluster": [
            "small"
          ]
        }
      }
    },
    "policy": {
      "sections": {
        "secondary-storage": {
          "allowed": [
            "elasticsearch",
            "database-server"
          ]
        }
      },
      "parameters": {
        "elasticsearch": {
          "preset": {
            "claimEditable": true,
            "allowed": [
              {
                "name": "small",
                "label": "Small",
                "value": "small"
              }
            ]
          }
        }
      }
    },
    "selections": [
      {
        "section": "secondary-storage",
        "registration": "elasticsearch",
        "parameters": {
          "preset": "large"
        }
      }
    ]
  },
  "result": {
    "refusal": {
      "reason": "NotAllowed",
      "message": "parameter \"preset\" of registration \"elasticsearch\" has the name \"large\", which is not one of small"
    }
  }
}
