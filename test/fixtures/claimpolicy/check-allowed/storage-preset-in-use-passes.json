{
  "schemaVersion": 1,
  "name": "A preset that the request of the selection already carries passes after the Environment drops it",
  "input": {
    "environment": {
      "metadata": {
        "name": "dev"
      },
      "spec": {
        "presets": {
          "elasticsearchCluster": [
            "small"
          ]
        }
      }
    },
    "policy": {
      "sections": {
        "secondary-storage": {
          "allowed": [
            "elasticsearch",
            "database-server"
          ]
        }
      },
      "parameters": {
        "elasticsearch": {
          "preset": {
            "value": "large"
          }
        }
      }
    },
    "selections": [
      {
        "section": "secondary-storage",
        "registration": "elasticsearch"
      }
    ],
    "requests": [
      {
        "metadata": {
          "name": "orders-secondary-storage"
        },
        "spec": {
          "section": "secondary-storage",
          "registration": "elasticsearch",
          "parameters": {
            "preset": "large"
          }
        }
      }
    ]
  },
  "result": {
    "value": {}
  }
}
