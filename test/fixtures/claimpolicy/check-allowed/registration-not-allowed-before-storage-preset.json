{
  "schemaVersion": 1,
  "name": "A registration that the snapshot does not allow is refused before its preset is checked",
  "input": {
    "environment": {
      "metadata": {
        "name": "dev"
      },
      "spec": {
        "presets": {
          "elasticsearchCluster": [
            "small"
          ]
        }
      }
    },
    "policy": {
      "sections": {
        "secondary-storage": {
          "allowed": [
            "database-server"
          ]
        }
      },
      "parameters": {
        "elasticsearch": {
          "preset": {
            "claimEditable": true
          }
        }
      }
    },
    "selections": [
      {
        "section": "secondary-storage",
        "registration": "elasticsearch",
        "parameters": {
          "preset": "large"
        }
      }
    ]
  },
  "result": {
    "refusal": {
      "reason": "NotAllowed",
      "message": "registration \"elasticsearch\" is not allowed in section \"secondary-storage\""
    }
  }
}
