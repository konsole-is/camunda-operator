{
  "schemaVersion": 1,
  "name": "A claim can select nothing in a section that is not required",
  "input": {
    "environment": {
      "metadata": {
        "name": "dev"
      },
      "spec": {
        "presets": {
          "camundaCluster": [
            "small"
          ]
        },
        "releases": {
          "allowed": [
            "8.9.23"
          ],
          "default": "8.9.23"
        }
      }
    },
    "policy": {
      "sections": {
        "backup-storage": {
          "allowed": [
            "s3",
            "existing-object-storage"
          ]
        }
      },
      "parameters": {
        "s3": {
          "region": {
            "value": "eu-west-1"
          },
          "access": {
            "claimEditable": true,
            "allowed": [
              {
                "name": "sqs",
                "label": "SQS access",
                "value": "arn:aws:iam::aws:policy/AmazonSQSFullAccess"
              },
              {
                "name": "sns",
                "label": "SNS access",
                "value": "arn:aws:iam::aws:policy/AmazonSNSFullAccess"
              }
            ]
          }
        }
      },
      "deletionPolicy": "Delete"
    },
    "selections": []
  },
  "result": {
    "value": {}
  }
}
