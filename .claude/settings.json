{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-plugins.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "simple-english@simple-english": true,
    "feature-dev-workflow@feature-dev-workflow": true
  },
  "extraKnownMarketplaces": {
    "simple-english": {
      "source": {
        "source": "github",
        "repo": "AminBlg/SimpleEnglish"
      }
    },
    "feature-dev-workflow": {
      "source": {
        "source": "github",
        "repo": "sourcehawk/feature-dev-workflow"
      }
    }
  }
}
