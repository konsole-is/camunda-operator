{
  "name": "fleet-manager",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "26.11.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:gallery": "FLEET_DEV_GALLERY=1 next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0 . && prettier --check . && next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "gallery": "rm -rf ui-gallery test-results && playwright test",
    "generate": "node scripts/generate-crd-types.mts ../config/crd/bases src/generated/crds"
  },
  "dependencies": {
