    "@noble/hashes": "2.4.0",
    "@tanstack/react-query": "5.104.1",
    "ajv": "8.20.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "isomorphic-git": "1.43.0",
    "lucide-react": "1.55.0",
    "next": "16.4.1",
    "radix-ui": "1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
