{
  "name": "fleet-manager",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:envtest": "FLEET_ENVTEST_BUILD=1 next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0 . && prettier --check . && next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "app-test": "rm -rf test-results/app && playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "stories": "rm -rf ui-stories story-snapshot test-results/stories && playwright test -c playwright.stories.config.ts",
    "scenarios": "rm -rf ui-pages test-results/scenarios && playwright test -c playwright.scenarios.config.ts",
    "generate": "node scripts/generate-crd-types.mts ../config/crd/bases src/generated/crds"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "@kubernetes/client-node": "2.0.2",
    "@noble/hashes": "2.4.0",
    "@tanstack/react-query": "5.107.1",
    "ajv": "8.20.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "isomorphic-git": "1.44.11",
    "lucide-react": "1.70.0",
    "next": "16.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/nextjs-vite": "10.6.7",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "31.0.1",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.10.1",
    "shadcn": "4.23.0",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
