// Writes one TypeScript module for each CRD of the operator, with the spec,
// the status, and the resource type of its kind. make fleet-generate runs it.
//
// Usage: node scripts/generate-crd-types.mts <crd dir> <out dir>
import fs from "node:fs/promises";
import path from "node:path";
import { compile, type JSONSchema } from "json-schema-to-typescript";
import { format } from "prettier";
import { parse } from "yaml";

/** Crd is the part of a CustomResourceDefinition that the script reads. */
export interface Crd {
  metadata: { name: string };
  spec: {
    group: string;
    names: { kind: string };
    versions: {
      name: string;
      served: boolean;
      schema?: { openAPIV3Schema: JSONSchema };
    }[];
  };
}

/** GeneratedFile is one module of src/generated/crds. */
export interface GeneratedFile {
  name: string;
  source: string;
}

/**
 * renderCrdTypes returns the module of the kind of crd. It exports
 * `<Kind>Spec` and `<Kind>Status` when the schema has them, and `<Kind>` with
 * apiVersion, kind, and metadata. source names the CRD file in the header.
 * It refuses a CRD that serves more than one version, because the type
 * names hold no version.
 */
export async function renderCrdTypes(
  crd: Crd,
  source: string,
): Promise<GeneratedFile> {
  const { group, names, versions } = crd.spec;
  const served = versions.filter((v) => v.served);
  if (served.length !== 1) {
    throw new Error(
      `${crd.metadata.name} serves ${served.length} versions, and the generated type names hold no version`,
    );
  }

  const [version] = served;
  if (!version.schema) {
    throw new Error(
      `version ${version.name} of ${crd.metadata.name} has no schema`,
    );
  }

  const kind = names.kind;
  const root = withPreservedFields(
    structuredClone(version.schema.openAPIV3Schema),
  );
  const properties = root.properties ?? {};
  if (properties.spec) properties.spec.title = `${kind}Spec`;
  if (properties.status) properties.status.title = `${kind}Status`;
  root.title = kind;
  root.properties = {
    ...properties,
    apiVersion: { tsType: JSON.stringify(`${group}/${version.name}`) },
    kind: { tsType: JSON.stringify(kind) },
    metadata: { tsType: "V1ObjectMeta" },
  };
  root.required = [
    ...new Set([
      ...(Array.isArray(root.required) ? root.required : []),
      "apiVersion",
      "kind",
      "metadata",
    ]),
  ];

  const types = await compile(root, kind, {
    additionalProperties: false,
    bannerComment: "",
    format: false,
    // Without it, a list with maxItems becomes a union of tuples, and a
    // string[] does not fit it.
    maxItems: -1,
  });
  const header = [
    `// Code generated by scripts/generate-crd-types.mts from ${source}. DO NOT EDIT.`,
    "// Run make fleet-generate to update it.",
    "",
    'import type { V1ObjectMeta } from "@kubernetes/client-node";',
    "",
  ].join("\n");

  return {
    name: `${kind.toLowerCase()}.ts`,
    source: await format(`${header}\n${types}`, { parser: "typescript" }),
  };
}

/**
 * withPreservedFields types each part of schema with
 * x-kubernetes-preserve-unknown-fields: an object gets an index signature,
 * and a part without a type, which holds any JSON value, gets unknown. It
 * changes schema in place and returns it.
 */
function withPreservedFields(schema: JSONSchema): JSONSchema {
  if (schema["x-kubernetes-preserve-unknown-fields"] === true) {
    if (schema.type === undefined && schema.properties === undefined) {
      schema.tsType = "unknown";
    } else if (schema.additionalProperties === undefined) {
      schema.additionalProperties = true;
    }
  }

  const children = [
    ...Object.values(schema.properties ?? {}),
    ...[schema.items ?? []].flat(),
    ...(schema.anyOf ?? []),
    ...(schema.allOf ?? []),
    ...(schema.oneOf ?? []),
  ];
  if (typeof schema.additionalProperties === "object") {
    children.push(schema.additionalProperties);
  }
  children.forEach(withPreservedFields);

  return schema;
}

/**
 * writeCrdTypes writes the module of each CRD in crdDir to outDir and
 * removes every other file of outDir, so a removed kind leaves no module. It
 * refuses two kinds that would write the same module.
 */
export async function writeCrdTypes(
  crdDir: string,
  outDir: string,
): Promise<void> {
  const entries = (await fs.readdir(crdDir))
    .filter((name) => name.endsWith(".yaml"))
    .sort();

  const files = new Map<string, GeneratedFile>();
  for (const entry of entries) {
    const crd = parse(
      await fs.readFile(path.join(crdDir, entry), "utf8"),
    ) as Crd;
    const file = await renderCrdTypes(crd, entry);
    if (files.has(file.name)) {
      throw new Error(`two CRDs write ${file.name}`);
    }
    files.set(file.name, file);
  }

  await fs.rm(outDir, { recursive: true, force: true });
  await fs.mkdir(outDir, { recursive: true });
  for (const file of files.values()) {
    await fs.writeFile(path.join(outDir, file.name), file.source);
  }
}

if (import.meta.main) {
  const [crdDir, outDir] = process.argv.slice(2);
  if (!crdDir || !outDir) {
    console.error(
      "usage: node scripts/generate-crd-types.mts <crd dir> <out dir>",
    );
    process.exit(2);
  }
  await writeCrdTypes(crdDir, outDir);
}
